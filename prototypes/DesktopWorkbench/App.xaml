<Application x:Class="DesktopWorkbench.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InkBrush" Color="#17272B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5D6B70"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#137C72"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Background" Value="#E9F1F0"/>
      <Setter Property="Foreground" Value="#17272B"/>
      <Setter Property="BorderBrush" Value="#CCD9D8"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#17272B"/>
    </Style>
  </Application.Resources>
</Application>
