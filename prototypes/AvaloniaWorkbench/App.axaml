<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mps.AvaloniaWorkbench.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#137F71" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Noto Sans CJK SC" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="#EDF1F1" />
      <Setter Property="Foreground" Value="#203033" />
      <Setter Property="BorderBrush" Value="#DCE4E3" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#E2ECEA" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#137F71" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#137F71" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#0F6A5F" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="8" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="Button.sidebar">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B9CBC9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="39" />
    </Style>
    <Style Selector="Button.sidebar:pointerover">
      <Setter Property="Background" Value="#2A3A3D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.sidebar.active">
      <Setter Property="Background" Value="#28534F" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="#D7E1DF" />
      <Setter Property="Background" Value="White" />
    </Style>
  </Application.Styles>
</Application>
